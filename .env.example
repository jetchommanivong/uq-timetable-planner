# Postgres connection string. Works with Neon, Supabase, Vercel Postgres or a
# local server. Copy this file to .env and paste your own URL in.
#
#   Neon / Supabase:  postgresql://user:password@host/dbname?sslmode=require
#   Local:            postgresql://postgres:postgres@localhost:5432/uqtt
#
# TLS is enabled automatically for anything that isn't localhost.
DATABASE_URL=

# Optional. Connections held per instance; keep it small on serverless.
# PG_POOL_MAX=3
